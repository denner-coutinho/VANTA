# ───────── Geral ─────────
NODE_ENV=development
# ───────── Banco de dados (PostgreSQL) ─────────
DATABASE_URL=postgresql://vanta:vanta@localhost:5432/vanta?schema=public
# Banco separado usado pelos testes automatizados (é limpo a cada execução)
TEST_DATABASE_URL=postgresql://vanta:vanta@localhost:5432/vanta_test?schema=public
# ───────── Redis (rate limit, sessões temporárias, matchmaking futuro) ─────────
REDIS_URL=redis://localhost:6379
# ───────── API ─────────
API_PORT=4000
GAME_PORT=4100
API_HOST=0.0.0.0
# Origens autorizadas a chamar a API (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173
# URL pública do cliente (usada nos links de e-mail)
PUBLIC_APP_URL=http://localhost:5173
# ───────── Autenticação ─────────
# Caminho das rotas de auth como o navegador as vê (cliente acessa a API via /api, pelo proxy).
REFRESH_COOKIE_PATH=/api/auth
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=troque-este-segredo-de-acesso-com-pelo-menos-32-caracteres
# Cifra os segredos da verificação em duas etapas. Vazio em desenvolvimento: deriva do JWT_ACCESS_SECRET.
# Obrigatória em produção (e diferente do JWT_ACCESS_SECRET).
MFA_ENCRYPTION_KEY=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# ───────── E-mail (SMTP) ─────────
# Sem SMTP_HOST, os e-mails são registrados no log do servidor (somente desenvolvimento).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="VANTA: FRONTLINE <no-reply@vanta.gg>"
# ───────── Stripe (Fase 6) ─────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# ───────── Cliente (Vite: só variáveis VITE_* chegam ao navegador; nunca coloque segredos aqui) ─────────
VITE_API_URL=http://localhost:4000

# Libera GET /metrics (Prometheus) com "Authorization: Bearer <token>". Vazio: desligado.
METRICS_TOKEN=
