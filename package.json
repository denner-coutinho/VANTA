{
  "name": "vanta-frontline",
  "private": true,
  "version": "0.1.0",
  "description": "VANTA: FRONTLINE — FPS multiplayer competitivo",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @vanta/server --filter @vanta/client run \"/^dev(:game)?$/\"",
    "dev:server": "pnpm --filter @vanta/server dev",
    "dev:client": "pnpm --filter @vanta/client dev",
    "build": "pnpm --filter @vanta/shared build && pnpm --filter @vanta/db build && pnpm -r --filter ./apps/* build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @vanta/db generate",
    "db:migrate": "pnpm --filter @vanta/db migrate:dev",
    "db:deploy": "pnpm --filter @vanta/db migrate:deploy",
    "db:seed": "pnpm --filter @vanta/db seed",
    "db:reset": "pnpm --filter @vanta/db reset",
    "dev:game": "pnpm --filter @vanta/server dev:game"
  }
}
